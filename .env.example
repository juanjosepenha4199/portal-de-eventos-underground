# Base de datos SQLite (modo local sin Postgres)
# Ejemplo: file:./dev.db
# Si la app se queda cargando, asegúrate de: 1) npx prisma generate  2) no tener otra instancia (otra terminal con npm run dev, o Prisma Studio) usando la misma DB
DATABASE_URL="file:./dev.db"

# NextAuth
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-por-secreto-seguro-generado"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (pasarela de pagos)
# Claves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook: en Dashboard → Developers → Webhooks → Add endpoint → URL: https://tu-dominio.com/api/webhooks/stripe
# Eventos: checkout.session.completed. El secreto se muestra al crear el endpoint.
STRIPE_WEBHOOK_SECRET="whsec_..."

# EBANX (opcional — para Nequi real)
# Obtener en https://www.ebanx.com (Merchant Signup). Sandbox para pruebas.
EBANX_INTEGRATION_KEY=""
# production = producción; cualquier otro = sandbox
EBANX_MODE="sandbox"

# Nequi Conecta (opcional — API oficial)
# Credenciales y URL en https://conecta.nequi.com.co (POST /token)
NEQUI_CLIENT_ID=""
NEQUI_CLIENT_SECRET=""
NEQUI_TOKEN_URL=""
NEQUI_API_BASE_URL=""
