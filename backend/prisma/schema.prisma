// Prisma schema - Underground Portal de Eventos
// Base de datos: SQLite (modo local sin Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER      // cliente / asistente
  ORGANIZER // vendedor: publica eventos (requiere solicitud aprobada)
  ADMIN     // gestiona contenido
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // null para usuarios que solo inician sesión con Google/OAuth
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizedEvents   Event[]
  favorites        Favorite[]
  tickets          Ticket[]
  sellerApplication   SellerApplication?
}

// Solicitud para ser vendedor (ORGANIZER): Instagram, seguidores, documento de identidad, etc.
model SellerApplication {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  instagramHandle     String
  instagramFollowers  Int
  idDocumentNumber    String                   // cédula o documento de identificación
  idDocumentUrl       String?                  // URL de documento subido (opcional)
  phone               String?
  status              SellerApplicationStatus  @default(PENDING)
  createdAt           DateTime                 @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?                  // admin userId
  rejectionReason     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String
  category    String      // música, arte, cultura, etc.
  dateTime    DateTime
  location    String
  image       String?     // URL de imagen
  price       String?     // texto para mostrar: "FREE", "$25.000"
  priceCents  Int?        // valor numérico en centavos (para carrito y pasarela)
  status      EventStatus @default(ACTIVE)
  organizerId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizer User     @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  favorites Favorite[]
  tickets   Ticket[]

  @@index([status, dateTime])
  @@index([category])
}

enum TicketStatus {
  PENDING   // sesión creada, sin pagar
  PAID      // pago confirmado por Stripe
  CANCELLED
}

model Ticket {
  id                 String       @id @default(cuid())
  userId             String
  eventId            String
  amountCents        Int          // importe en céntimos (Stripe)
  currency           String       @default("eur")
  stripeSessionId    String?      @unique // id de Stripe Checkout Session
  status             TicketStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([stripeSessionId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}
