# Base de datos SQLite (modo local sin Postgres)
# Ejemplo: file:./dev.db
# Si la app se queda cargando, asegúrate de: 1) npx prisma generate  2) no tener otra instancia (otra terminal con npm run dev, o Prisma Studio) usando la misma DB
DATABASE_URL="file:./dev.db"

# NextAuth
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-por-secreto-seguro-generado"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (inicio de sesión con cuenta de Google)
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# Tipo: "Aplicación web" → URIs de redirección autorizados: NEXTAUTH_URL + /api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (pasarela de pagos)
# Claves en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook: en Dashboard → Developers → Webhooks → Add endpoint → URL: https://tu-dominio.com/api/webhooks/stripe
# Eventos: checkout.session.completed. El secreto se muestra al crear el endpoint.
STRIPE_WEBHOOK_SECRET="whsec_..."
